{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": false,
  "automerge": false,
  "gitIgnoredAuthors": ["github-actions[bot]@users.noreply.github.com"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "matchManagers": ["npm", "pip_requirements", "gomod"]
    },
    {
      "description": "Automerge vulnerability alert updates only",
      "matchJsonata": ["$exists(isVulnerabilityAlert) and isVulnerabilityAlert = true"],
      "automerge": true
    }
  ],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "NO-ISSUE: chore(deps):"
}
